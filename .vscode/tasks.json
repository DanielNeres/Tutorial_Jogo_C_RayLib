{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Raylib",
            "command": "C:/raylib/w64devkit/bin/gcc.exe",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}/jogo.exe",
                "-m64",
                "-O1",
                "-Wall",
                "-std=c99",
                "-Wno-missing-braces",
                "-I", "C:/raylib/raylib/src",
                "-L", "C:/raylib/raylib/src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "env": {
                    "PATH": "C:/raylib/w64devkit/bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}